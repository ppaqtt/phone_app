<?xml version="1.0" encoding="utf-8"?>
<!--
  F3: 桌面小部件整体布局。
  - 顶部标题 (清笺 + 数量)
  - 中部 ListView 显示最近 5 条笔记
  - 底部"新建笔记"按钮
  整体半透明卡片, 圆角 16dp, 主题色背景。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_title"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/widget_title" />

        <TextView
            android:id="@+id/widget_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/widget_subtitle" />
    </LinearLayout>

    <ListView
        android:id="@+id/widget_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:scrollbars="none" />

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/widget_empty"
        android:textSize="13sp"
        android:textColor="@color/widget_subtitle"
        android:visibility="gone" />

    <Button
        android:id="@+id/widget_new_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/widget_new_note"
        android:textColor="@color/widget_button_text"
        android:textSize="13sp"
        android:background="@drawable/widget_button_bg"
        android:padding="8dp" />
</LinearLayout>
