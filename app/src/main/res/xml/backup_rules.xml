<?xml version="1.0" encoding="utf-8"?>
<!-- 自动备份配置: 仅备份用户数据, 不备份应用状态 -->
<full-backup-content>
    <!-- 备份数据库文件 -->
    <include domain="database" path="notes.db" />
    
    <!-- 备份 DataStore 偏好设置 -->
    <include domain="sharedpref" path="." />
    
    <!-- 排除缓存目录 -->
    <exclude domain="cache" path="." />
    
    <!-- 排除图片缓存 -->
    <exclude domain="files" path="images" />
</full-backup-content>