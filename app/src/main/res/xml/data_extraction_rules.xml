<?xml version="1.0" encoding="utf-8"?>
<!-- 数据迁移规则: 控制应用迁移/设备传输时的数据处理 -->
<data-extraction-rules>
    <!-- 云端备份: 遵循 full-backup-content 的配置 -->
    <cloud-backup>
        <include domain="database" path="notes.db" />
        <include domain="sharedpref" path="." />
        <exclude domain="cache" path="." />
        <exclude domain="files" path="images" />
    </cloud-backup>
    
    <!-- 设备间传输: 传输所有必要数据 -->
    <device-transfer>
        <include domain="database" path="notes.db" />
        <include domain="sharedpref" path="." />
        <exclude domain="cache" path="." />
    </device-transfer>
</data-extraction-rules>